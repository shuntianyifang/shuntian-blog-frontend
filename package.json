{
  "name": "shuntian-blog-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:fixture": "node scripts/generate.mjs --fixture",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
