worker_processes 1;
pid logs/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 128; }
http {
    types {
        text/html html;
        text/css css;
        application/javascript js mjs;
        application/json json;
        image/svg+xml svg;
        image/png png;
        image/jpeg jpg jpeg;
        image/webp webp;
        font/woff2 woff2;
        image/x-icon ico;
    }
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_max_body_size 1m;
    server {
        listen 127.0.0.1:__PORT__;
        server_name 127.0.0.1;
        root "__PUBLIC__";
        index index.html;
        add_header X-Content-Type-Options nosniff always;
        location ^~ /api/ {
            proxy_pass http://127.0.0.1:__API_PORT__;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 15s;
        }
        location ^~ /_nuxt/ { try_files $uri =404; }
        location = /admin { try_files /admin/index.html =404; add_header Cache-Control no-store; }
        location ^~ /admin/ { try_files $uri /admin/index.html; add_header Cache-Control no-store; }
        location / { try_files $uri $uri/index.html =404; }
        error_page 404 /404.html;
        location = /404.html { internal; }
    }
}
